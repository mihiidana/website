# Applied by Cloudflare Workers static assets.
# https://developers.cloudflare.com/workers/static-assets/headers/
#
# The page-level CSP lives in a <meta> tag (astro.config.mjs). Meta CSP cannot
# enforce frame-ancestors, so clickjacking protection is set here instead.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY

# Social cards are page-stable, not content-hashed: re-publishing a post can
# change the bytes behind the same URL, so they must not be cached immutably.
/og/*
  Cache-Control: public, max-age=0, must-revalidate
