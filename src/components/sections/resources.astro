---
import { ArrowUpRight } from "@lucide/svelte";

import { Card } from "@/components/ui/card";
import type { SiteResource } from "@/lib/site";

interface Props {
  heading: string;
  items: readonly SiteResource[];
}

const { heading, items } = Astro.props;
---

<section aria-labelledby="resources-heading" class="border-t pt-6">
  <h2 id="resources-heading" class="text-lg font-semibold tracking-tight">{heading}</h2>
  <ul class="mt-4 grid gap-3 sm:grid-cols-3">
    {items.map((item) => (
      <li>
        <a
          href={item.href}
          target="_blank"
          rel="noopener noreferrer"
          class="group block h-full rounded-xl focus-visible:ring-3 focus-visible:ring-ring/50 focus-visible:outline-none"
        >
          <Card class="h-full gap-1 p-3 transition-all duration-200 group-hover:-translate-y-0.5 group-hover:ring-foreground/25 group-focus-visible:-translate-y-0.5 group-focus-visible:ring-foreground/25 motion-safe:group-active:translate-y-0">
            <span class="flex items-center justify-between gap-2 text-sm font-medium">
              {item.title}
              <ArrowUpRight
                aria-hidden="true"
                class="size-3.5 opacity-0 transition-all duration-200 group-hover:opacity-100 group-focus-visible:opacity-100 motion-safe:-translate-x-0.5 motion-safe:translate-y-0.5 motion-safe:group-hover:translate-x-0 motion-safe:group-hover:translate-y-0 motion-safe:group-focus-visible:translate-x-0 motion-safe:group-focus-visible:translate-y-0"
              />
            </span>
            <span class="font-mono text-xs text-muted-foreground">{item.source}</span>
          </Card>
        </a>
      </li>
    ))}
  </ul>
</section>
