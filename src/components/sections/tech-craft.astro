---
import { Badge } from "@/components/ui/badge";
import type { SiteLink } from "@/lib/site";

interface Props {
  heading: string;
  items: readonly SiteLink[];
}

const { heading, items } = Astro.props;
---

<section aria-labelledby="tech-heading" class="border-t pt-6">
  <h2 id="tech-heading" class="text-lg font-semibold tracking-tight">{heading}</h2>
  <ul class="mt-4 flex flex-wrap gap-1.5">
    {items.map((item) => (
      <li>
        <a
          href={item.href}
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-md focus-visible:ring-3 focus-visible:ring-ring/50 focus-visible:outline-none"
        >
          <Badge
            variant="outline"
            className="h-7 rounded-md px-2.5 font-mono text-xs font-normal text-muted-foreground"
          >
            {item.label}
          </Badge>
        </a>
      </li>
    ))}
  </ul>
</section>
