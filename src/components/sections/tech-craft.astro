---
import { ArrowUpRight } from "@lucide/svelte";

import { Badge } from "@/components/ui/badge";
import type { SiteLink } from "@/lib/site";

interface Props {
  heading: string;
  items: readonly SiteLink[];
}

const { heading, items } = Astro.props;
---

<section aria-labelledby="tech-heading" class="border-t pt-6">
  <h2 id="tech-heading" class="text-lg font-semibold tracking-tight">{heading}</h2>
  <ul class="mt-4 flex flex-wrap gap-1.5">
    {items.map((item) => (
      <li>
        <a
          href={item.href}
          target="_blank"
          rel="noopener noreferrer"
          class="group rounded-md focus-visible:ring-3 focus-visible:ring-ring/50 focus-visible:outline-none"
        >
          <Badge
            variant="outline"
            class="h-7 rounded-md border-border px-2.5 font-mono text-xs font-normal text-muted-foreground transition-all duration-200 group-hover:border-foreground/30 group-hover:bg-muted group-hover:text-foreground group-focus-visible:border-foreground/30 group-focus-visible:bg-muted group-focus-visible:text-foreground motion-safe:group-hover:-translate-y-0.5 motion-safe:group-active:translate-y-0 motion-safe:group-focus-visible:-translate-y-0.5"
          >
            {item.label}
            <ArrowUpRight
              data-icon="inline-end"
              aria-hidden="true"
              class="opacity-0 transition-all duration-200 group-hover:opacity-100 group-focus-visible:opacity-100 motion-safe:-translate-x-0.5 motion-safe:translate-y-0.5 motion-safe:group-hover:translate-x-0 motion-safe:group-hover:translate-y-0 motion-safe:group-focus-visible:translate-x-0 motion-safe:group-focus-visible:translate-y-0"
            />
          </Badge>
        </a>
      </li>
    ))}
  </ul>
</section>
