---
/**
 * BlogPosting structured data for an article.
 *
 * The script is inline JSON, so CSP requires its hash. Astro hashes bundled
 * scripts itself but not `is:inline` ones, so the hash is computed from the
 * exact serialized text and registered before the page renders.
 *
 * Only real data is emitted: no author name, organization, or image is
 * invented. `image` stays absent until per-article social images exist.
 */
import { site } from "@/lib/site";

interface Props {
  title: string;
  description: string;
  published: string;
  modified?: string;
  url: string;
}

const { title, description, published, modified, url } = Astro.props;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  url,
  mainEntityOfPage: url,
  datePublished: published,
  ...(modified ? { dateModified: modified } : {}),
  publisher: { "@type": "Organization", name: site.name, url: site.url },
};

const payload = JSON.stringify(jsonLd);
const digest = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(payload));
const hash = btoa(String.fromCharCode(...new Uint8Array(digest)));
Astro.csp?.insertScriptHash(`sha256-${hash}`);
---

<script type="application/ld+json" is:inline set:html={payload} />
