---
/**
 * Page head metadata: title, description, canonical URL, Open Graph, and
 * Twitter Card. Titles compose with the site name; copy comes from props
 * (which pages source from `site.ts` or the content collection) — never
 * invent content here.
 *
 * Every page gets its own generated social image: the path is derived from the
 * page's own route (`src/lib/og/paths.ts`), which is exactly the path
 * `/og/[...path].png` writes at build time. There is no override — a
 * hand-picked image could not be verified against the build, so it would either
 * ship unvalidated or fail the gate. See AGENTS.md → Open Graph images.
 */
import { ogImageAlt, ogImagePath } from "@/lib/og/paths";
import { site } from "@/lib/site";

interface Props {
  title?: string;
  description?: string;
  /** Open Graph object type. */
  type?: "website" | "article";
  /** ISO date of first publication (articles only). */
  publishedTime?: string;
  /** ISO date of the last edit (articles only). */
  modifiedTime?: string;
}

const {
  title = site.name,
  description = site.description,
  type = "website",
  publishedTime,
  modifiedTime,
} = Astro.props;

const pageTitle = title === site.name ? site.name : `${title} — ${site.name}`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const socialImage = new URL(ogImagePath(Astro.url.pathname), Astro.site).href;
const socialImageAlt = ogImageAlt({ title: pageTitle, description });
---

<!-- Primary -->
<title>{pageTitle}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonicalUrl}>
<link rel="alternate" type="application/rss+xml" title={site.writing.feedTitle} href="/rss.xml">

<!-- Open Graph -->
<meta property="og:title" content={pageTitle}>
<meta property="og:description" content={description}>
<meta property="og:type" content={type}>
<meta property="og:url" content={canonicalUrl}>
<meta property="og:site_name" content={site.name}>
{publishedTime && <meta property="article:published_time" content={publishedTime}>}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime}>}
<meta property="og:image" content={socialImage}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:type" content="image/png">
<meta property="og:image:alt" content={socialImageAlt}>

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={pageTitle}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={socialImage}>
<meta name="twitter:image:alt" content={socialImageAlt}>
