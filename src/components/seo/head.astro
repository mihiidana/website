---
/**
 * Page head metadata: title, description, canonical URL, Open Graph, and
 * Twitter Card. Titles compose with the site name; copy comes from props
 * (which pages source from `site.ts`) — never invent content here.
 *
 * `type`, `publishedTime`, `modifiedTime`, and `image` exist for articles.
 * `image` is optional so per-article social images can be added later
 * without reshaping this component; nothing generates images yet.
 */
import { site } from "@/lib/site";

interface Props {
  title?: string;
  description?: string;
  /** Open Graph object type. */
  type?: "website" | "article";
  /** ISO date of first publication (articles only). */
  publishedTime?: string;
  /** ISO date of the last edit (articles only). */
  modifiedTime?: string;
  /** Absolute or root-relative social image URL. */
  image?: string;
}

const {
  title = site.name,
  description = site.description,
  type = "website",
  publishedTime,
  modifiedTime,
  image,
} = Astro.props;
const pageTitle = title === site.name ? site.name : `${title} — ${site.name}`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = image ? new URL(image, Astro.site).href : undefined;
---

<!-- Primary -->
<title>{pageTitle}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonicalUrl}>
<link rel="alternate" type="application/rss+xml" title={site.blog.feedTitle} href="/rss.xml">

<!-- Open Graph -->
<meta property="og:title" content={pageTitle}>
<meta property="og:description" content={description}>
<meta property="og:type" content={type}>
<meta property="og:url" content={canonicalUrl}>
<meta property="og:site_name" content={site.name}>
{publishedTime && <meta property="article:published_time" content={publishedTime}>}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime}>}
{imageUrl && <meta property="og:image" content={imageUrl}>}

<!-- Twitter -->
<meta name="twitter:card" content={imageUrl ? "summary_large_image" : "summary"}>
<meta name="twitter:title" content={pageTitle}>
<meta name="twitter:description" content={description}>
{imageUrl && <meta name="twitter:image" content={imageUrl}>}
