---
/**
 * Every page's head metadata, rendered from one centralized build:
 * `src/lib/seo.ts` composes the values, this component writes the tags, and
 * `src/lib/seo/jsonld.ts` describes the same page to search engines.
 *
 * There is no page-specific OG-image override. Each indexable route advertises
 * the card generated from its own path (`/og/**`), which the build checker can
 * prove exists at exactly 1200×630. Noindex pages omit social images entirely
 * so they never point at a card that was not generated.
 */
import JsonLd from "@/components/seo/json-ld.astro";
import type { PageSeoInput } from "@/lib/seo";
import { buildPageSeo } from "@/lib/seo";
import { buildStructuredData } from "@/lib/seo/jsonld";
import { site } from "@/lib/site";

interface Props extends Omit<PageSeoInput, "route"> {}

const seo = buildPageSeo({ ...Astro.props, route: Astro.url.pathname });
const jsonLd = buildStructuredData(seo);
const rssUrl = new URL("/rss.xml", site.url).href;
---

<!-- Primary -->
<title>{seo.title}</title>
<meta name="description" content={seo.description}>
{seo.noindex && <meta name="robots" content="noindex, nofollow">}
<link rel="canonical" href={seo.canonical}>
<link rel="alternate" type="application/rss+xml" title={site.writing.feedTitle} href={rssUrl}>

<!-- Open Graph -->
<meta property="og:title" content={seo.title}>
<meta property="og:description" content={seo.description}>
<meta property="og:type" content={seo.type}>
<meta property="og:url" content={seo.canonical}>
<meta property="og:site_name" content={seo.siteName}>
<meta property="og:locale" content={seo.locale}>
{seo.publishedTime && <meta property="article:published_time" content={seo.publishedTime}>}
{seo.modifiedTime && <meta property="article:modified_time" content={seo.modifiedTime}>}
{seo.image && (
  <>
    <meta property="og:image" content={seo.image.url}>
    <meta property="og:image:alt" content={seo.image.alt}>
    <meta property="og:image:width" content={String(seo.image.width)}>
    <meta property="og:image:height" content={String(seo.image.height)}>
    <meta property="og:image:type" content={seo.image.type}>
  </>
)}

<!-- Twitter -->
<meta name="twitter:card" content={seo.twitter.card}>
<meta name="twitter:title" content={seo.title}>
<meta name="twitter:description" content={seo.description}>
{seo.twitter.site && <meta name="twitter:site" content={seo.twitter.site}>}
{seo.twitter.creator && <meta name="twitter:creator" content={seo.twitter.creator}>}
{seo.image && (
  <>
    <meta name="twitter:image" content={seo.image.url}>
    <meta name="twitter:image:alt" content={seo.image.alt}>
  </>
)}

<JsonLd data={jsonLd} />
