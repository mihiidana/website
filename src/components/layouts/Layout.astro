---
import { Font } from "astro:assets";
import "@/styles/global.css";

import Container from "@/components/layouts/container.astro";
import SiteFooter from "@/components/layouts/footer.astro";
import SiteHeader from "@/components/layouts/header.astro";
import PageHead from "@/components/seo/head.astro";
import type { PageSeoInput } from "@/lib/seo";
import { site } from "@/lib/site";
import { THEME_COLORS, THEME_STORAGE_KEY } from "@/lib/theme";

/**
 * Page metadata is required, not defaulted: a route cannot quietly ship the
 * homepage's title and description. Add the remaining page facts (type, dates,
 * breadcrumbs, listing items) through this same interface; `PageHead` and the
 * JSON-LD builder derive every tag from them.
 */
interface Props extends Omit<PageSeoInput, "route"> {}

const {
  title,
  description,
  type,
  noindex,
  isNotFound,
  publishedTime,
  modifiedTime,
  breadcrumbs,
  items,
} = Astro.props;

// Pre-paint theme bootstrap: applies the persisted (or default dark) theme
// before first render. It must stay inline, so constants are interpolated
// from `lib/theme.ts` at build time — the toggle and the bootstrap share one
// source of truth. Bundled scripts are CSP-hashed by Astro; this one
// registers its own hash below.
const themeBootstrap = `
(() => {
  const root = document.documentElement;
  const storageKey = ${JSON.stringify(THEME_STORAGE_KEY)};
  const themeColors = ${JSON.stringify(THEME_COLORS)};
  let theme = "dark";
  try {
    const stored = localStorage.getItem(storageKey);
    if (stored === "light" || stored === "dark") theme = stored;
  } catch {
    // Storage can be blocked; the dark default still applies.
  }
  root.classList.toggle("dark", theme === "dark");
  document
    .querySelector('meta[name="theme-color"]')
    ?.setAttribute("content", themeColors[theme]);
})();
`;

const bootstrapDigest = await crypto.subtle.digest(
  "SHA-256",
  new TextEncoder().encode(themeBootstrap),
);
const bootstrapHash = btoa(String.fromCharCode(...new Uint8Array(bootstrapDigest)));
Astro.csp?.insertScriptHash(`sha256-${bootstrapHash}`);
---

<!doctype html>
<html class="dark" lang={site.seo.lang}>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="icon" href="/favicon.ico" sizes="32x32">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="manifest" href="/site.webmanifest">
    <meta name="theme-color" content={THEME_COLORS.dark}>
    <meta name="generator" content={Astro.generator}>
    <PageHead
      title={title}
      description={description}
      type={type}
      noindex={noindex}
      isNotFound={isNotFound}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      breadcrumbs={breadcrumbs}
      items={items}
    />
    <script is:inline set:html={themeBootstrap} />
    <Font cssVariable="--font-satoshi" preload />
    <Font cssVariable="--font-caveat" preload />
    <slot name="head" />
  </head>
  <body id="top">
    <a
      href="#main"
      class="absolute top-0 left-4 z-50 -translate-y-full bg-background px-4 py-2 text-sm font-medium outline-none focus:translate-y-2 focus:ring-3 focus:ring-ring/50"
    >
      Skip to content
    </a>
    <Container class="flex min-h-svh flex-col">
      <SiteHeader />
      <main id="main" class="flex-1 scroll-mt-20 py-10 outline-none" tabindex="-1">
        <slot />
      </main>
      <SiteFooter />
    </Container>
  </body>
</html>
