---
import { Font } from "astro:assets";
import "@/styles/global.css";

import Container from "@/components/layouts/container.astro";
import SiteFooter from "@/components/site-footer.astro";
import SiteHeader from "@/components/site-header.astro";
import { site } from "@/lib/site";

interface Props {
  description?: string;
  title?: string;
}

const { description = site.description, title = site.name } = Astro.props;
---

<!doctype html>
<html class="dark" lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content={description}>
    <link rel="icon" href="/favicon.ico" sizes="32x32">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="manifest" href="/site.webmanifest">
    <meta name="theme-color" content="#0a0a0a">
    <meta name="generator" content={Astro.generator}>
    <title>{title}</title>
    <script is:inline>
    (() => {
      const root = document.documentElement;
      let theme = "dark";

      try {
        const stored = localStorage.getItem("theme");
        if (stored === "light" || stored === "dark") theme = stored;
      } catch {
        // Storage can be blocked; the dark default still applies.
      }

      root.classList.toggle("dark", theme === "dark");
      document
        .querySelector('meta[name="theme-color"]')
        ?.setAttribute("content", theme === "dark" ? "#0a0a0a" : "#ffffff");
    })();
    </script>
    <Font cssVariable="--font-satoshi" preload />
    <Font cssVariable="--font-caveat" preload />
    <slot name="head" />
  </head>
  <body id="top">
    <a
      href="#main"
      class="absolute top-0 left-4 z-50 -translate-y-full bg-background px-4 py-2 text-sm font-medium outline-none focus:translate-y-2 focus:ring-3 focus:ring-ring/50"
    >
      Skip to content
    </a>
    <Container class="flex min-h-svh flex-col">
      <SiteHeader />
      <main id="main" class="flex-1 scroll-mt-20 py-10 outline-none" tabindex="-1">
        <slot />
      </main>
      <SiteFooter />
    </Container>
  </body>
</html>
