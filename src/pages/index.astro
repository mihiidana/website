---
import { getImage } from "astro:assets";
import Layout from "@/components/layouts/Layout.astro";
import Resources from "@/components/sections/resources.astro";
import TechCraft from "@/components/sections/tech-craft.astro";
import Clock from "@/components/widgets/clock.svelte";
import LedMatrix from "@/components/widgets/led-matrix.svelte";
import MusicPlayer from "@/components/widgets/music-player.svelte";
import { site } from "@/lib/site";

const page = site.pages.home;
const { widgets, resources, techStack } = page;

// Widget displays the artwork at ~320px; download once at build time and
// convert to webp instead of hotlinking YouTube's 1280px jpeg.
const track = widgets?.music;
const optimizedArtwork = track
  ? (await getImage({ src: track.artwork, width: 320, height: 320, format: "webp" })).src
  : undefined;
---

<Layout>
  <div class="flex max-w-xl flex-col gap-4">
    <h1 class="text-4xl font-semibold tracking-tight text-balance sm:text-5xl">
      {page.title}
    </h1>
    <p class="text-pretty text-lg text-muted-foreground">{page.intro}</p>
  </div>

  {widgets && (
    <div class="mt-12 grid auto-rows-fr grid-cols-12 gap-3.5">
      <div class="col-span-12 grid min-w-0 md:col-span-6">
        <MusicPlayer client:visible track={widgets.music} artwork={optimizedArtwork} />
      </div>
      <div class="col-span-12 flex gap-3.5 md:contents">
        <div class="grid min-w-0 flex-1 md:col-span-3">
          <Clock client:idle />
        </div>
        <div class="grid min-w-0 flex-1 md:col-span-3">
          <LedMatrix client:visible />
        </div>
      </div>
    </div>
  )}

  {(page.sections.length > 0 || resources || techStack) && (
    <div class="mt-14 flex flex-col gap-10">
      {page.sections.map((section) => (
        <section class="border-t pt-6">
          <h2 class="text-lg font-semibold tracking-tight">{section.heading}</h2>
          <p class="mt-2 max-w-xl text-pretty text-muted-foreground">{section.body}</p>
          {section.links && section.links.length > 0 && (
            <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm">
              {section.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="underline underline-offset-4 transition-colors hover:text-muted-foreground focus-visible:rounded-sm focus-visible:ring-3 focus-visible:ring-ring/50 focus-visible:outline-none"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </section>
      ))}
      {resources && <Resources heading={resources.heading} items={resources.items} />}
      {techStack && <TechCraft heading={techStack.heading} items={techStack.items} />}
    </div>
  )}
</Layout>
