---
/**
 * Writing archive: every published post, newest first. Drafts are filtered by
 * `publishedPosts()` and never appear in the production build.
 */
import { getCollection } from "astro:content";

import PostList from "@/components/blog/post-list.astro";
import Layout from "@/components/layouts/Layout.astro";
import { publishedPosts } from "@/lib/blog";
import { site } from "@/lib/site";

const posts = publishedPosts(await getCollection("blog"));
const copy = site.writing;
---

<Layout title={copy.title} description={copy.description}>
  <div class="flex flex-col gap-4">
    <h1 class="text-4xl font-semibold tracking-tight text-balance sm:text-5xl">{copy.title}</h1>
    <p class="text-pretty text-lg text-muted-foreground">{copy.intro}</p>
  </div>

  {posts.length === 0 ? (
    <p class="mt-12 text-pretty text-muted-foreground">{copy.empty}</p>
  ) : (
    <div class="mt-12">
      <PostList posts={posts} />
    </div>
  )}
</Layout>
