---
/**
 * Article page. One template for `.md` and `.mdx`: `render()` returns the
 * same `<Content />` component for both, and the shared `prose` typography
 * styles both identically.
 *
 * Static: `getStaticPaths()` emits one page per published entry at build.
 */
import { getCollection, render } from "astro:content";

import "@/styles/prose.css";

import Layout from "@/components/layouts/Layout.astro";
import ArticleJsonLd from "@/components/seo/article-json-ld.astro";
import { displayDate, isoDate, postPath, publishedPosts } from "@/lib/blog";

export async function getStaticPaths() {
  const posts = publishedPosts(await getCollection("blog"));
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, pubDate, updatedDate } = post.data;
const published = isoDate(pubDate);
const updated = updatedDate ? isoDate(updatedDate) : undefined;
const canonical = new URL(postPath(post.id), Astro.site).href;
---

<Layout
  title={title}
  description={description}
  type="article"
  publishedTime={published}
  modifiedTime={updated}
>
  <ArticleJsonLd
    slot="head"
    title={title}
    description={description}
    published={published}
    modified={updated}
    url={canonical}
  />
  <article>
    <header class="flex flex-col gap-3 border-b pb-8">
      <nav aria-label="Breadcrumb" class="font-mono text-xs">
        <a
          href="/blog/"
          class="text-muted-foreground transition-colors hover:text-foreground focus-visible:rounded-sm focus-visible:ring-3 focus-visible:ring-ring/50 focus-visible:outline-none"
        >
          ← Writing
        </a>
      </nav>
      <h1 class="text-3xl font-semibold tracking-tight text-balance sm:text-4xl">{title}</h1>
      <p class="text-pretty text-lg text-muted-foreground">{description}</p>
      <p class="flex flex-wrap items-center gap-x-2 font-mono text-xs text-muted-foreground">
        <time datetime={published}>Published {displayDate(pubDate)}</time>
        {updatedDate && (
          <>
            <span aria-hidden="true">·</span>
            <time datetime={updated}>Updated {displayDate(updatedDate)}</time>
          </>
        )}
      </p>
    </header>

    <div class="prose mt-8 max-w-none">
      <Content />
    </div>
  </article>
</Layout>
