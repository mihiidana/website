{
  "name": "website",
  "type": "module",
  "version": "0.0.1",
  "license": "MIT",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26.13.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "deploy": "pnpm run build && wrangler deploy",
    "prepare": "simple-git-hooks"
  },
  "lint-staged": {
    "*.{js,ts,astro,json,jsonc,css,mjs,cjs}": "biome check --write"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.4",
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.8",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "lint-staged": "^17.6.0",
    "simple-git-hooks": "^2.14.0",
    "wrangler": "^4.158.0"
  }
}
