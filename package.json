{
  "name": "website",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26.13.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "deploy": "pnpm run build && wrangler deploy",
    "prepare": "simple-git-hooks"
  },
  "lint-staged": {
    "*.{js,ts,astro,json,jsonc,css,mjs,cjs}": "biome check --write"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "dependencies": {
    "astro": "^7.4.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "lint-staged": "^17.6.0",
    "simple-git-hooks": "^2.14.0",
    "wrangler": "^4.158.0"
  }
}
