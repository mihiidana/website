{
  "name": "website",
  "type": "module",
  "version": "0.0.1",
  "license": "MIT",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26.13.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "astro check && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "validate": "pnpm check && pnpm typecheck && pnpm test && pnpm build && pnpm test:e2e",
    "deploy": "pnpm run build && wrangler deploy",
    "prepare": "simple-git-hooks"
  },
  "lint-staged": {
    "*.{js,ts,astro,json,jsonc,css,mjs,cjs}": "biome check --write"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.4",
    "@astrojs/svelte": "^9.1.5",
    "@base-ui/react": "^1.9.0",
    "@lucide/svelte": "^1.72.0",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.8",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "svelte": "^5.57.3",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "2.6.6",
    "@internationalized/date": "^3.12.4",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "bits-ui": "^2.21.0",
    "lint-staged": "^17.6.0",
    "simple-git-hooks": "^2.14.0",
    "svelte-check": "^4.7.8",
    "tailwind-variants": "^3.3.1",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
